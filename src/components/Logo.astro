---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import logo from '~/assets/images/kyrix-logo.jpg';
---

<span class="flex items-center">
  <Image src={logo} alt={SITE?.name} width={40} height={40} class="h-10 w-10 rounded-md" loading="eager" />
  <span
    class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
  >
    {SITE?.name}
  </span>
</span>
