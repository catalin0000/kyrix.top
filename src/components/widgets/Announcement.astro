---
// Thin bar above the header. Rendered only when explicit props are provided.
export interface Props {
  badge?: string;
  text?: string;
  href?: string;
  showStars?: boolean;
}

const { badge = '', text = '', href = '', showStars = false } = Astro.props;
---

{
  text ? (
    <div class="text-sm bg-slate-900 text-slate-300 dark:bg-transparent dark:border-b dark:border-slate-800 dark:text-slate-400 hidden lg:flex gap-1 overflow-hidden px-3 py-2 relative text-ellipsis whitespace-nowrap">
      {badge && (
        <span class="bg-white/20 dark:bg-slate-700 text-slate-100 dark:text-slate-300 font-semibold px-1 py-0.5 text-xs mr-0.5 rtl:mr-0 rtl:ml-0.5 inline-block">
          {badge}
        </span>
      )}
      {href ? (
        <a href={href} class="text-slate-300 hover:underline dark:text-slate-400 font-medium" set:html={text} />
      ) : (
        <span class="text-slate-300 dark:text-slate-400 font-medium" set:html={text} />
      )}
      {showStars && (
        <span class="sr-only">Announcement</span>
      )}
    </div>
  ) : null
}
