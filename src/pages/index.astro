---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import kyrixPillIcon from '~/assets/images/kyrixpill-icon.png';
import kyrixHydrationIcon from '~/assets/images/kyrixhydration-icon.png';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Kyrix - Private, Native Android Apps',
  description:
    'Kyrix builds fast, beautiful, and 100% offline-first Android apps designed to respect your privacy and protect your personal data.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    tagline="Kyrix Studio"
    title="Thoughtful, Private Android Apps"
    image={{ src: '~/assets/images/kyrix-logo.jpg', alt: 'Kyrix logo' }}
    actions={[
      { variant: 'primary', text: 'Explore KyrixPill', href: '#apps' },
      { variant: 'secondary', text: 'Privacy Policies', href: getPermalink('/privacy') },
    ]}
  >
    <Fragment slot="subtitle">
      We craft focused, battery-efficient, and <strong>100% offline-first</strong> Android utilities designed to keep your
      personal information completely secure on your physical device.
    </Fragment>
  </Hero>

  <!-- Featured Apps Section -->
  <section id="apps" class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-5xl">
    <div class="text-center mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-primary dark:text-blue-400">Our Applications</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-slate-900 dark:text-white mt-1">
        Featured Apps
      </h2>
      <p class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        Tools engineered with privacy-by-design, beautiful Material 3 aesthetics, and zero external trackers.
      </p>
    </div>

    <div class="space-y-10">
      <!-- Kyrix Hydration Showcase Card -->
      <div
        class="p-8 sm:p-10 rounded-3xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 shadow-md hover:shadow-xl transition-all"
      >
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
          <Image
            src={kyrixHydrationIcon}
            alt="Kyrix Hydration: Daily Water Tracker"
            class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl shadow-lg border border-slate-200 dark:border-slate-700 object-cover flex-shrink-0"
          />

          <div class="flex-1 text-center md:text-left">
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-2">
              <h3 class="text-2xl sm:text-3xl font-extrabold font-heading text-slate-900 dark:text-white">Kyrix Hydration</h3>
              <span
                class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-cyan-100 dark:bg-cyan-950/60 text-cyan-800 dark:text-cyan-300"
              >
                Water Tracker
              </span>
              <span
                class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300"
              >
                100% Offline
              </span>
            </div>

            <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed mb-6">
              The fluid, beautiful daily water intake tracker. Features interactive wave liquid visualization, gentle interval
              reminders, 12 immersive visual themes, custom drinks, home screen widgets, and complete offline privacy.
            </p>

            <!-- Feature Bullets Grid -->
            <div
              class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 mb-8"
            >
              <div class="flex items-center gap-1.5 justify-center md:justify-start">
                <span>🌊</span> Wave Liquid Glass
              </div>
              <div class="flex items-center gap-1.5 justify-center md:justify-start">
                <span>⏰</span> Daytime Reminders
              </div>
              <div class="flex items-center gap-1.5 justify-center md:justify-start">
                <span>🎨</span> 12 Immersive Themes
              </div>
              <div class="flex items-center gap-1.5 justify-center md:justify-start">
                <span>📱</span> Home Screen Widgets
              </div>
              <div class="flex items-center gap-1.5 justify-center md:justify-start">
                <span>☕</span> 8 Drinks + Custom
              </div>
              <div class="flex items-center gap-1.5 justify-center md:justify-start">
                <span>🔒</span> Zero Trackers & Ads
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
              <a
                href={getPermalink('/privacy/kyrixhydration')}
                class="px-5 py-2.5 rounded-xl font-semibold text-sm bg-primary text-white hover:bg-blue-700 transition-colors shadow-sm"
              >
                Privacy Policy →
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- KyrixPill Showcase Card -->
    <div
      class="p-8 sm:p-10 rounded-3xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 shadow-md hover:shadow-xl transition-all"
    >
      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <Image
          src={kyrixPillIcon}
          alt="KyrixPill: Medication Tracker"
          class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl shadow-lg border border-slate-200 dark:border-slate-700 object-cover flex-shrink-0"
        />

        <div class="flex-1 text-center md:text-left">
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-2">
            <h3 class="text-2xl sm:text-3xl font-extrabold font-heading text-slate-900 dark:text-white">KyrixPill</h3>
            <span
              class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300"
            >
              Medication Tracker
            </span>
            <span
              class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300"
            >
              100% Offline
            </span>
          </div>

          <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed mb-6">
            The smart, private medication reminder, pill tracker, dosage log, and adherence calendar. Built to make
            tracking prescriptions, vitamins, and supplements effortless without sharing your health data with anyone.
          </p>

          <!-- Feature Bullets Grid -->
          <div
            class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-300 mb-8"
          >
            <div class="flex items-center gap-1.5 justify-center md:justify-start">
              <span>⏰</span> Exact Scheduled Alarms
            </div>
            <div class="flex items-center gap-1.5 justify-center md:justify-start">
              <span>📊</span> Today's Adherence Rings
            </div>
            <div class="flex items-center gap-1.5 justify-center md:justify-start">
              <span>📑</span> Doctor PDF Reports
            </div>
            <div class="flex items-center gap-1.5 justify-center md:justify-start">
              <span>💊</span> Stock & Refill Alerts
            </div>
            <div class="flex items-center gap-1.5 justify-center md:justify-start">
              <span>🔒</span> Zero Cloud Telemetry
            </div>
            <div class="flex items-center gap-1.5 justify-center md:justify-start">
              <span>🚫</span> Zero In-App Ads
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
            <a
              href={getPermalink('/privacy/kyrixpill')}
              class="px-5 py-2.5 rounded-xl font-semibold text-sm bg-primary text-white hover:bg-blue-700 transition-colors shadow-sm"
            >
              Privacy Policy →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  </section>

  <!-- Studio Philosophy Features -->
  <Features2
    title="The Kyrix Difference"
    subtitle="Why we believe software should be simple, respectful, and private."
    columns={3}
    items={[
      {
        title: '100% Offline & Private',
        description:
          'Your health, habits, and schedules belong exclusively to you. None of our apps require an account, and none send your data over the internet.',
        icon: 'tabler:lock',
      },
      {
        title: 'Native Performance',
        description:
          'Engineered directly in Kotlin and Android Jetpack Compose for buttery-smooth 120Hz frame rates, instant startup times, and minimal battery consumption.',
        icon: 'tabler:bolt',
      },
      {
        title: 'No Subscriptions',
        description:
          'We reject monthly recurring fees for personal utilities. Download for free and optionally unlock unlimited profiles with a single lifetime purchase.',
        icon: 'tabler:coin',
      },
    ]}
  />

  <!-- Call to Action -->
  <CallToAction
    title="Take control of your daily health routines"
    subtitle="Explore our privacy-first Android applications or review our strict data policies."
    actions={[
      {
        variant: 'primary',
        text: 'Hydration Policy',
        href: getPermalink('/privacy/kyrixhydration'),
      },
      {
        variant: 'secondary',
        text: 'KyrixPill Policy',
        href: getPermalink('/privacy/kyrixpill'),
      },
      {
        variant: 'secondary',
        text: 'Contact Developer',
        href: 'mailto:support@kyrix.top',
      },
    ]}
  />
</Layout>
